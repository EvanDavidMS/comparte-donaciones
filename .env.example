# Copia este archivo a .env (no se sube al repositorio) o define las variables en tu entorno.
NODE_ENV=development
PORT=3000
# Obligatorio en producción, mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_SEC=7200
ADMIN_EMAIL=admin@comparte.org
ADMIN_PASSWORD=
# Archivo donde el servidor guarda los datos (sin base de datos). "none" = solo memoria.
DATA_FILE=data/db.json
SEED_DEMO=true
DEMO_PASSWORD=Demo12345
COOKIE_SECURE=false
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=600
