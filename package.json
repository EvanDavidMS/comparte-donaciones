{
  "name": "conecta-mas-donaciones",
  "version": "1.0.0",
  "description": "Conecta +: plataforma para gestionar donaciones de alimentos y recursos entre empresas (donantes) y organizaciones sociales (beneficiarias).",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node --env-file=demo.env src/server.js",
    "dev": "node --env-file=demo.env --watch src/server.js",
    "test": "jest --coverage",
    "test:ci": "jest --coverage --ci",
    "lint": "eslint .",
    "smoke": "node scripts/smoke-test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "donaciones",
    "jwt",
    "express",
    "ci-cd"
  ],
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov",
      "json-summary",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "reports/pruebas",
          "outputName": "junit.xml"
        }
      ]
    ]
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "supertest": "^7.3.0"
  }
}
